/*****************************************************************************/
/* Place Holder when a dictionary is deleted */
/*****************************************************************************/
module SKStore;

class DeletedDir private {
  time: Time,
  timeStack: TimeStack,
  dirName: DirName,
} extends Dir {
  static fun ofDir(dir: Dir): this {
    time = dir.getTime();
    timeStack = dir.getTimeStack();
    dirName = dir.getDirName();
    static{time, timeStack, dirName}
  }

  fun getTime(): Time {
    this.time
  }
  fun getTimeStack(): TimeStack {
    this.timeStack
  }
  fun getArrayRaw<K, F>(K): Array<F> {
    Array[]
  }

  fun getArray<K, F>(mutable Context, K): Array<F> {
    Array[]
  }

  fun getIter<K, F>(mutable Context, K): mutable Iterator<F> {
    mutable EmptyIterator()
  }

  fun keys<K: Orderable>(): SortedSet<K> {
    SortedSet[]
  }
  fun getDirName(): DirName {
    this.dirName
  }
}

module end;
